    {
      "id": "claim_70fe564c28d74cf7a9d2ad88d28c4639",
      "statement": "Each `create_server` call constructs exactly one `Shell` and one shared lock; both `run` and, when present, `edit` execute their shell-dependent critical sections under that lock, preventing concurrent calls from interleaving shared state.",
      "evidence": [
        {
          "resource": "repo://src/mcpath/server.py#L82-L135",
          "version": "repo-lines-v1:sha256:c4bb3102d144dd9bff1610ccec448e7937731777f9444d1ac69181d7a68b0e0b:"
