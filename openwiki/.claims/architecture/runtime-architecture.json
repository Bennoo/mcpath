    {
      "id": "claim_ad492a9ac35c42be8c8e0d4734be3c80",
      "statement": "The `mcpath` CLI parses the mount root, read-only and deny options, output limit, and stdio/HTTP transport settings; it constructs a URL-backed VFS, creates the FastMCP server, and launches stdio without a banner or HTTP with the configured host and port.",
      "evidence": [
        {
          "resource": "repo://pyproject.toml#L17-L18",
          "version": "repo-lines-v1:sha256:4301e51bc1a7126876bfff874bbd294161596f5212d32bb48c42f2ad3aa44f39:"
